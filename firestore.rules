rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /rooms/{code} {
      // Czytać pokój może gracz (w players) albo ekran hosta (w observers, SPEC §3.9).
      // Dołączanie i rejestracja obserwatora idą przez API (Admin SDK), więc to nie blokuje wejścia.
      allow read: if signedIn() && (
        request.auth.uid in resource.data.players ||
        (resource.data.observers != null && request.auth.uid in resource.data.observers)
      );
      allow write: if false;

      match /private/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /secret/{doc} {
        allow read, write: if false;   // WYŁĄCZNIE Admin SDK
      }

      match /events/{id} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
  }
}
